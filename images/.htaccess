# Uploaded files must never be executed.
Options -ExecCGI -Indexes
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pl|py|cgi|sh)$">
  Require all denied
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=2592000"
</IfModule>
